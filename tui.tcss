/* Keep the normal mouse arrow over every widget, including text fields. */
Screen, Screen * {
    pointer: default;
}
Screen {
    background: #0a080f;
    color: #d8d1e5;
}
#masthead {
    height: 2;
    padding: 0 2;
    background: #0a080f;
}
#brand {
    width: 1fr;
    color: #b990ff;
    text-style: bold;
}
#tagline {
    width: auto;
    color: #76618f;
}
#workspace {
    height: 1fr;
    padding: 0 1;
}
#settings {
    width: 40;
    height: 1fr;
    border: round #7653a8;
    padding: 0 1;
    margin-right: 1;
    scrollbar-size: 1 1;
}
.section-title {
    width: 1fr;
    text-align: center;
    text-style: bold;
    color: #b990ff;
    margin-bottom: 1;
}
.field-label {
    color: #b990ff;
    margin-top: 1;
    height: 1;
}
Input, Select {
    width: 1fr;
    margin: 0;
}
Input {
    border: none;
    background: #110d19;
    height: 1;
}
Input:focus {
    background: #302044;
    border: none;
}
Select > SelectCurrent {
    background: #110d19;
    border: none;
}
Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    height: 1;
    margin-top: 1;
}
Checkbox > .toggle--button {
    color: #21192d;
    background: #21192d;
}
Checkbox.-on > .toggle--button {
    color: #ace36c;
}
.hint {
    color: #9385a6;
    height: auto;
    margin: 1 0;
}
Button {
    background: #20152f;
    border: tall #493160;
    color: #cbb5ed;
    min-width: 5;
}
Button:hover, Button:focus {
    background: #4b2b76;
    border: tall #b990ff;
}
#generate {
    width: 1fr;
    margin-top: 1;
    background: #4b2b76;
}
.button-row {
    height: 3;
}
.button-row Button {
    width: 1fr;
}
#main {
    width: 1fr;
    height: 1fr;
}
#voicings-panel {
    height: 1fr;
    border: round #7653a8;
    padding: 0 1;
}
#toolbar {
    height: 1;
    margin: 1 0;
}
#result-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #b990ff;
}
#sort, #view, #position {
    width: 18;
    margin-left: 1;
}
#chord-info {
    height: auto;
    color: #67dce2;
    margin-bottom: 1;
}
#results-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}
#cards {
    grid-size: 2;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 1 1;
    height: auto;
}
.voicing-card {
    height: auto;
    min-width: 29;
    padding: 0 1;
    border: solid #45354f;
    background: #0d0a12;
    overflow-x: auto;
    text-wrap: nowrap;
}
.voicing-card:hover {
    border: solid #b990ff;
}
.voicing-card:focus, .voicing-card.selected {
    border: solid #b990ff;
    background: #302044;
}
#empty {
    height: auto;
    padding: 3 1;
    content-align: center middle;
    color: #9385a6;
}
#pagination {
    height: 3;
    margin-top: 1;
}
#card-help {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: #9385a6;
}
#page-label {
    width: 16;
    height: 3;
    content-align: center middle;
    color: #67dce2;
}
#previous, #next {
    width: 5;
}
#progression-panel {
    height: 18;
    max-height: 45%;
    border: round #7653a8;
    padding: 0 1;
    margin-top: 1;
}
#progression-heading {
    height: 3;
}
#progression-title {
    width: 1fr;
    height: 3;
    color: #b990ff;
    content-align: left middle;
}
#progression {
    height: 1fr;
    scrollbar-size: 1 1;
    overflow-y: auto;
}
.progression-card {
    width: auto;
    min-width: 32;
    margin-right: 1;
}
#progression-empty {
    width: 1fr;
    height: auto;
    padding: 2 1;
    color: #9385a6;
    text-align: center;
}
#status {
    height: 1;
    padding: 0 2;
    color: #aaa0ba;
}
Footer {
    background: #20152f;
    color: #cbb5ed;
}
